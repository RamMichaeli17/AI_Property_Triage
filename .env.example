# =============================================================================
# AI Property Triage Platform — Environment Configuration Template
# Duplicate this file to `.env` and insert your actual credentials.
# =============================================================================

# Google Gemini API Key (Used by Guardrails Service & n8n Information Extractor)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-Compatible Gemini Endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama Endpoint for Docker Containers (Routes to host-level Ollama server)
OLLAMA_HOST=http://host.docker.internal:11434

# Sibling Microservice Internal Network Endpoints (Used by LangGraph Agent inside Docker)
RAG_SERVICE_URL=http://rag-service:8001/query/
IMAGE_SERVICE_URL=http://image-service:8002/analyse

# n8n Webhook Intake Endpoint (Configured for Streamlit submission)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/listing-submission